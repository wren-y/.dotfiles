!!---------------------------------------------------------------------------
!! Dimensions

border.width:			        2
window.inactive.border.color:	resource.inactive_tab_background
window.active.border.color:	resource.active_tab_background

padding.width:				    6
window.handle.width:			2
window.client.padding.width:	0
window.client.padding.height:	0

menu.overlap:				    0

!!---------------------------------------------------------------------------
!! Fonts

window.active.label.text.font:	shadow=y
window.label.text.justify:		left
menu.title.text.justify:		right

!!---------------------------------------------------------------------------
!! Menu Settings

menu.title.bg:				    flat solid
menu.title.bg.color:			resource.background
menu.title.bg.colorTo:			resource.foreground
menu.title.text.color:			resource.foreground

menu.items.bg:				    flat solid
menu.items.bg.color:			resource.inactive_tab_background
menu.items.text.color:			resource.inactive_tab_foreground

menu.items.active.bg:			flat solid
menu.items.active.bg.color:		resource.background
menu.items.active.text.color:		resource.foreground

menu.items.disabled.text.color:		resource.inative_border_color

!!---------------------------------------------------------------------------
!! Window Settings

window.active.padding.width:	    10
window.active.title.bg:			    flat solid
window.active.title.bg.color:	    resource.active_tab_background

window.active.label.bg:			    flat solid
window.active.label.bg.color:	    resource.active_tab_background
window.active.label.bg.colorTo:	    resource.active_tab_background
window.active.label.text.color:	    resourece.active_tab_foreground

window.active.handle.bg:		    flat solid
window.active.handle.bg.color:	    resource.active_tab_foreground
window.active.handle.bg.colorTo:    resource.active_tab_foreground

window.active.grip.bg:			    flat solid
window.active.grip.bg.color:	    resource.active_tab_background

window.active.client.color:         resource.active_tab_background
window.inactive.client.color:       resource.inactive_tab_background

window.inactive.title.bg:		    flat solid
window.inactive.title.bg.color:	    resource.inactive_tab_background

window.inactive.label.bg:		    parentrelative
window.inactive.label.text.color:	resource.inactive_tab_foreground

window.inactive.handle.bg:		    flat solid
window.inactive.handle.bg.color:	resource.inactive_tab_foreground

window.inactive.grip.bg:		    flat solid
window.inactive.grip.bg.color:		resource.inactive_tab_foreground

!!---------------------------------------------------------------------------
!! Button Settings

window.active.button.unpressed.bg:			    flat solid
window.active.button.unpressed.bg.color:	    resource.inactive_tab_foreground
window.active.button.unpressed.bg.colorTo:	    #272c30
window.active.button.unpressed.image.color:	    #bfc0d0

window.active.button.pressed.bg:			    flat solid
window.active.button.pressed.bg.color:		    #272c30
window.active.button.pressed.bg.colorTo:	    #272c30

window.active.button.hover.bg:			        flat solid
window.active.button.hover.bg.color:		    resource.active_tab_foreground

window.active.button.disabled.bg:			    parentrelative
window.active.button.disabled.image.color:	    #9394a2

window.inactive.button.unpressed.bg:			parentrelative
window.inactive.button.unpressed.image.color:	#9394a2

window.inactive.button.hover.bg:			    flat solid
window.inactive.button.hover.bg.color:			resource.inactive_tab_foreground
window.inactive.button.pressed.bg:			    flat solid
window.inactive.button.pressed.bg.color:		#272c30
window.inactive.button.pressed.bg.colorTo:		#272c30

window.inactive.button.disabled.bg:			    parentrelative
window.inactive.button.disabled.image.color:	#9394a2

!!--------------------------------------------------------------------------
!! On Screen Display

osd.border.width: 1
osd.hilight.bg: flat solid
osd.hilight.bg.color: #272c30
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #9394a2

